# Copy to .env (never commit .env itself) and change these before anything
# beyond local dev — docker-compose.yml falls back to the *-devpassword
# defaults below if this file doesn't exist, which is fine for a laptop but
# not for anything internet-facing.
POSTGRES_PASSWORD=postgres-devpassword
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak-devpassword
ARANGO_ROOT_PASSWORD=arango-devpassword
ARCADEDB_ROOT_PASSWORD=arcadedb-devpassword
GRAFANA_ADMIN_PASSWORD=grafana-devpassword

# ── Reasoning + evaluation (svc-agent, svc-guard) ──
# Free-tier Groq API key — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# svc-agent: user-facing answers.
GROQ_MODEL_ANSWER=llama-3.3-70b-versatile
# svc-guard: groundedness judge. Needs real reading comprehension across
# several retrieved chunks, not simple classification — the smaller
# "instant" tier measurably hallucinated ungrounded verdicts here, so this
# defaults to the same model tier as svc-agent, not a cheaper one.
GROQ_MODEL_JUDGE=llama-3.3-70b-versatile

# svc-agent's fallback provider when Groq errors/rate-limits (no key needed —
# runs locally via the `ollama` service in docker-compose.yml). Only
# override OLLAMA_MODEL if you've pulled a different model than the default.
# First-time setup: docker compose exec ollama ollama pull llama3.1:8b
# OLLAMA_MODEL=llama3.1:8b
